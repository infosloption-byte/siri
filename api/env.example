# Copy this to api/.env on the server and fill in real values.
# Do NOT commit the real .env file to git.

# --- Contact form (SMTP) ---
SMTP_USER=youraddress@gmail.com
SMTP_APP_PASSWORD=your16charapppassword
CONTACT_TO=youraddress@gmail.com

# --- Analytics dashboard auth ---
# Generate ADMIN_PASSWORD_HASH with: node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
ADMIN_PASSWORD_HASH=
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Google Analytics Data API (GA4) ---
# Base64-encode the service account JSON key: base64 -w0 service-account.json
GA_SERVICE_ACCOUNT_KEY_BASE64=
# Numeric GA4 property ID (Admin > Property Settings), NOT the G-XXXXX measurement ID
GA_PROPERTY_ID=

PORT=3001
